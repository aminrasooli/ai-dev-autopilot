  "_note_hooks": "Every hook is invoked as `bash <path>`, never as a bare path. Claude Code mounts hooks/ read-only inside a session, so a session cannot repair a lost executable bit on the file that constrains it; a hook registered as a bare path would then simply fail to spawn, and the ceiling would be gone without anything saying so. `bash <path>` depends on the file existing and being readable, which is the property `make sync` and bin/doctor can both check.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|NotebookEdit|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bash __AI_DEV_HOME__/hooks/security-guard.sh",
            "timeout": 10,
            "statusMessage": "AI-DEV security guard"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash __AI_DEV_HOME__/hooks/permission-broker.sh",
            "timeout": 20,
            "statusMessage": "AI-DEV approval broker"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash __AI_DEV_HOME__/hooks/session-start.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
