# Copy this file to .env in YOUR OWN project directory (never here) and fill
# in values. Never commit a real .env. Each project gets its own prefix and
# its own Console API key — this kit refuses to fall back to a bare
# ANTHROPIC_API_KEY (which may belong to a Claude Code subscription session,
# not this project's billed workspace).
#
# Replace JPAUTOPILOT with your project's prefix (uppercase, underscores).

JPAUTOPILOT_ANTHROPIC_API_KEY=
JPAUTOPILOT_MONTHLY_BUDGET_USD=20.00
JPAUTOPILOT_ROUTINE_MODEL=claude-haiku-4-5
JPAUTOPILOT_HARD_MODEL=claude-sonnet-5
