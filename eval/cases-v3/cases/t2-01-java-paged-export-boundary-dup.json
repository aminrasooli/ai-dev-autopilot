  "diff": [
    "--- a/reporting/src/main/java/com/acme/reporting/TransactionsExporter.java",
    "+++ b/reporting/src/main/java/com/acme/reporting/TransactionsExporter.java",
    "@@ -10,26 +10,50 @@",
    " /** Streams the daily transactions report as CSV. */",
    " public class TransactionsExporter {",
    " ",
    "     private static final Logger LOG = Logger.getLogger(TransactionsExporter.class.getName());",
    " ",
    "+    // Finance's month-end export ran the old single-query path out of",
    "+    // heap (about 4M rows). Page through the table instead, keeping at",
    "+    // most one page in memory. Fetch one row beyond the page size so we",
    "+    // can tell whether another page exists without a COUNT(*) round trip.",
    "+    private static final int PAGE_SIZE = 500;",
    "+",
    "     private final ReportDao dao;",
    " ",
    "     public TransactionsExporter(ReportDao dao) {",
    "         this.dao = dao;",
    "     }",
    " ",
    "     public int export(Instant since, Writer out) throws IOException {",
    "         out.write(\"id,account,amount_cents,created_at\\n\");",
    "-        List<TransactionRow> rows = dao.findSince(since);",
    "-        for (TransactionRow row : rows) {",
    "-            writeRow(out, row);",
    "+        int written = 0;",
    "+        int offset = 0;",
    "+        boolean hasMore = true;",
    "+        while (hasMore) {",
    "+            List<TransactionRow> rows = dao.findSince(since, PAGE_SIZE + 1, offset);",
    "+            hasMore = rows.size() > PAGE_SIZE;",
    "+            for (TransactionRow row : rows) {",
    "+                writeRow(out, row);",
    "+                written++;",
    "+            }",
    "+            out.flush();",
    "+            offset += PAGE_SIZE;",
    "+            LOG.fine(\"page done, written=\" + written);",
    "         }",
    "-        LOG.info(\"exported \" + rows.size() + \" rows\");",
    "-        return rows.size();",
    "+        LOG.info(\"exported \" + written + \" rows\");",
    "+        return written;",
    "     }",
    " ",
    "     private void writeRow(Writer out, TransactionRow row) throws IOException {",
    "-        out.write(row.id() + \",\" + row.account() + \",\"",
    "+        out.write(row.id() + \",\" + escape(row.account()) + \",\"",
    "                 + row.amountCents() + \",\" + row.createdAt() + \"\\n\");",
    "     }",
    "+",
    "+    // Accounts imported from the legacy system may contain commas.",
    "+    private static String escape(String field) {",
    "+        if (field.contains(\",\") || field.contains(\"\\\"\")) {",
    "+            return \"\\\"\" + field.replace(\"\\\"\", \"\\\"\\\"\") + \"\\\"\";",
    "+        }",
    "+        return field;",
    "+    }",
    " }",
    "--- a/reporting/src/main/java/com/acme/reporting/ReportDao.java",
    "+++ b/reporting/src/main/java/com/acme/reporting/ReportDao.java",
    "@@ -3,8 +3,13 @@",
    " import java.time.Instant;",
    " import java.util.List;",
    " ",
    " public interface ReportDao {",
    " ",
    "-    /** All transactions created at or after {@code since}, oldest first. */",
    "-    List<TransactionRow> findSince(Instant since);",
    "+    /**",
    "+     * Transactions created at or after {@code since}, oldest first,",
    "+     * paged with {@code LIMIT limit OFFSET offset}. Ordering is by",
    "+     * {@code (created_at, id)} so pages are stable while the export",
    "+     * runs.",
    "+     */",
    "+    List<TransactionRow> findSince(Instant since, int limit, int offset);",
    " }",
    "--- a/reporting/src/test/java/com/acme/reporting/TransactionsExporterTest.java",
    "+++ b/reporting/src/test/java/com/acme/reporting/TransactionsExporterTest.java",
    "@@ -2,10 +2,11 @@",
    " ",
    " import java.io.StringWriter;",
    " import java.time.Instant;",
    " import org.junit.jupiter.api.Test;",
    " import static org.junit.jupiter.api.Assertions.assertEquals;",
    "+import static org.junit.jupiter.api.Assertions.assertTrue;",
    " ",
    " class TransactionsExporterTest {",
    " ",
    "     @Test",
    "     void exportsAllRows() throws Exception {",
    "@@ -13,6 +14,22 @@",
    "         StringWriter out = new StringWriter();",
    "         int written = new TransactionsExporter(dao).export(Instant.EPOCH, out);",
    "         assertEquals(3, written);",
    "         assertEquals(4, out.toString().split(\"\\n\").length); // header + 3",
    "     }",
    "+",
    "+    @Test",
    "+    void escapesAccountsContainingCommas() throws Exception {",
    "+        FakeDao dao = FakeDao.withAccount(\"Smith, John\");",
    "+        StringWriter out = new StringWriter();",
    "+        new TransactionsExporter(dao).export(Instant.EPOCH, out);",
    "+        assertTrue(out.toString().contains(\"\\\"Smith, John\\\"\"));",
    "+    }",
    "+",
    "+    @Test",
    "+    void exportsEmptyReport() throws Exception {",
    "+        FakeDao dao = new FakeDao(0);",
    "+        StringWriter out = new StringWriter();",
    "+        int written = new TransactionsExporter(dao).export(Instant.EPOCH, out);",
    "+        assertEquals(0, written);",
    "+    }",
    " }"
  ],
  "ground_truth": {
    "defect": true,
    "category": "data-corruption",
    "accepted_categories": [
      "logic-error"
    ],
    "severity": [
      "medium",
      "high"
    ],
    "explanation": "The pagination fetches PAGE_SIZE + 1 rows per page so that rows.size() > PAGE_SIZE can signal another page without a COUNT query -- but the write loop then writes every fetched row, including the look-ahead row, and the offset advances by only PAGE_SIZE. The look-ahead row is therefore the first row of the next page too: every page-boundary row (row 501, 1001, ...) appears twice in the CSV, silently inflating a financial report. The loop should write only the first PAGE_SIZE rows (rows.subList(0, PAGE_SIZE)) when hasMore is true. All three tests use fewer rows than one page (0, 1, 3), so pagination never engages and the duplication is invisible to the suite."
  },
