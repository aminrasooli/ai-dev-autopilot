    "+\"\"\"Account restore (support tooling).\"\"\"",
    "+",
    "+",
    "+def restore_account(admin, account_id):",
    "+    \"\"\"Un-delete a soft-deleted account.",
    "+",
    "+    Refuses when the address has since been re-registered by a live",
    "+    account: two live rows for one email must never exist.",
    "+    \"\"\"",
    "+    account = repo.get_by_id(account_id)",
