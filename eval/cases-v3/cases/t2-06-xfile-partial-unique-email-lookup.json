    "+\"\"\"Allow re-registration after account deletion.",
    "+",
    "+Soft-deleted accounts keep their row (for billing history and audit),",
    "+which under the old global unique constraint made the email address",
    "+unusable forever. Scope uniqueness to live accounts only.",
    "+\"\"\"",
    "+",
    "+from alembic import op",
    "+",
    "+",
    "+revision = \"0051_partial_unique_email\"",
    "+down_revision = \"0050_add_account_flags\"",
    "+",
    "+",
    "+def upgrade():",
    "+    op.drop_constraint(\"uq_accounts_email\", \"accounts\")",
    "+    op.execute(",
    "+        \"CREATE UNIQUE INDEX uq_accounts_email_live \"",
    "+        \"ON accounts (lower(email)) WHERE deleted_at IS NULL\"",
    "+    )",
    "+",
    "+",
    "+def downgrade():",
    "+    op.execute(\"DROP INDEX uq_accounts_email_live\")",
