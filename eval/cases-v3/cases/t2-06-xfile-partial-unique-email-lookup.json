    "+import pytest",
    "+",
    "+from accounts.signup import register, EmailTaken",
    "+",
    "+",
    "+def test_register_rejects_a_live_duplicate(repo_with):",
    "+    repo_with(email=\"a@example.com\", deleted=False)",
    "+    with pytest.raises(EmailTaken):",
    "+        register(\"a@example.com\", \"hunter22\")",
    "+",
    "+",
    "+def test_register_allows_reregistering_a_deleted_address(repo_with):",
    "+    repo_with(email=\"b@example.com\", deleted=True)",
    "+    account = register(\"b@example.com\", \"hunter22\")",
    "+    assert account.deleted_at is None",
    "+",
    "+",
    "+def test_register_is_case_insensitive_on_the_duplicate_check(repo_with):",
    "+    repo_with(email=\"C@Example.com\", deleted=False)",
    "+    with pytest.raises(EmailTaken):",
