{
  "benchmark_version": 2,
  "id": "t1-01-py-gift-card-bulk-discount",
  "title": "Bulk discount tiers, added without excluding gift cards",
  "language": "python",
  "status": "pilot",
  "provenance": {
    "type": "authored-realistic",
    "author_family": "claude"
  },
  "affected_files": [
    "src/checkout/pricing.py",
    "tests/test_pricing.py"
  ],
  "diff": [
    "--- a/src/checkout/pricing.py",
    "+++ b/src/checkout/pricing.py",
    "@@ -7,20 +7,33 @@",
    " GIFT_CARD_SKU_PREFIX = \"GC-\"",
    " ",
    " SHIPPING_FLAT_RATE = 6.99",
    " FREE_SHIPPING_THRESHOLD = 75.00",
    " ",
    "+# Quantity-based bulk discount, stacked on top of any coupon discount.",
    "+# Encourages larger single-SKU orders without needing a coupon code.",
    "+BULK_DISCOUNT_TIERS = (",
    "+    (10, 0.03),",
    "+    (25, 0.06),",
    "+    (50, 0.10),",
    "+)",
    "+",
    " ",
    " def calculate_order_total(order):",
    "     \"\"\"Compute the final charge for an order, in the order's currency.\"\"\"",
    "     subtotal = _line_items_subtotal(order.items)",
    "-    discount = _apply_percentage_discount(order.items, subtotal, order.coupon)",
    "+    coupon_discount = _apply_percentage_discount(order.items, subtotal, order.coupon)",
    "+    bulk_discount = _apply_bulk_discount(order.items)",
    "+    discount = coupon_discount + bulk_discount",
    "     discounted_subtotal = subtotal - discount",
    "     shipping = _shipping_cost(discounted_subtotal, order.shipping_method)",
    "     tax = _tax(discounted_subtotal + shipping, order.region)",
    "     total = discounted_subtotal + shipping + tax",
    "-    logger.info(\"order %s total=%.2f (discount=%.2f)\", order.id, total, discount)",
    "+    logger.info(",
    "+        \"order %s total=%.2f (coupon=%.2f bulk=%.2f)\",",
    "+        order.id, total, coupon_discount, bulk_discount,",
    "+    )",
    "     return round(total, 2)",
    " ",
    " ",
    " def _line_items_subtotal(items):",
    "     return sum(item.unit_price * item.quantity for item in items)",
    "@@ -40,10 +53,27 @@",
    "     eligible = _eligible_for_discount(items)",
    "     eligible_subtotal = sum(i.unit_price * i.quantity for i in eligible)",
    "     return round(eligible_subtotal * coupon.percent_off / 100, 2)",
    " ",
    " ",
    "+def _bulk_discount_rate(quantity):",
    "+    rate = 0.0",
    "+    for threshold, tier_rate in BULK_DISCOUNT_TIERS:",
    "+        if quantity >= threshold:",
    "+            rate = tier_rate",
    "+    return rate",
    "+",
    "+",
    "+def _apply_bulk_discount(items):",
    "+    total = 0.0",
    "+    for item in items:",
    "+        rate = _bulk_discount_rate(item.quantity)",
    "+        if rate:",
    "+            total += item.unit_price * item.quantity * rate",
    "+    return round(total, 2)",
    "+",
    "+",
    " def _shipping_cost(discounted_subtotal, method):",
    "     if discounted_subtotal >= FREE_SHIPPING_THRESHOLD and method == \"standard\":",
    "         return 0.0",
    "     return SHIPPING_FLAT_RATE",
    " ",
    "--- a/tests/test_pricing.py",
    "+++ b/tests/test_pricing.py",
    "@@ -20,5 +20,17 @@",
    "         coupon=active_coupon,",
    "     )",
    "     total = calculate_order_total(order)",
    "     # Only the SKU-2 line should have been discounted.",
    "     assert total > 100.00",
    "+",
    "+",
    "+def test_bulk_discount_applies_above_tier_threshold(order_factory):",
    "+    order = order_factory(items=[(\"SKU-3\", 5.00, 12)])",
    "+    total = calculate_order_total(order)",
    "+    assert total < 5.00 * 12 + 6.99",
    "+",
    "+",
    "+def test_bulk_discount_stacks_with_coupon(order_factory, active_coupon):",
    "+    order = order_factory(items=[(\"SKU-4\", 8.00, 30)], coupon=active_coupon)",
    "+    total = calculate_order_total(order)",
    "+    assert total < 8.00 * 30 + 6.99"
  ],
  "ground_truth": {
    "defect": true,
    "category": "logic-error",
    "accepted_categories": [
      "unsafe-default"
    ],
    "severity": [
      "high",
      "critical"
    ],
    "explanation": "_apply_bulk_discount() iterates over order.items directly instead of _eligible_for_discount(items), so gift-card SKUs bought in quantity >= 10 receive the new bulk discount even though the adjacent, unmodified _apply_percentage_discount() still correctly excludes them. Gift cards are store-value products: discounting them lets an attacker buy discounted gift cards and redeem them at full face value, a direct arbitrage. The new tests cover the bulk-discount happy path but never a bulk purchase of a GC- SKU, so nothing catches it."
  },
  "difficulty": "subtle",
  "tags": [
    "larger-diff"
  ]
}
