{
  "benchmark_version": 2,
  "id": "t1-05-xfile-migration-sentinel-loss",
  "title": "NOT NULL default backfill quietly retires a manual-triage signal",
  "language": "python",
  "status": "pilot",
  "provenance": {
    "type": "authored-realistic",
    "author_family": "claude"
  },
  "affected_files": [
    "migrations/0043_backfill_order_priority.py",
    "src/orders/model.py",
    "src/orders/worker.py",
    "tests/test_worker.py",
    "CHANGELOG.md"
  ],
  "diff": [
    "--- a/migrations/0043_backfill_order_priority.py",
    "+++ b/migrations/0043_backfill_order_priority.py",
    "@@ -0,0 +1,21 @@",
    "+\"\"\"Backfill and enforce a default order priority.",
    "+",
    "+Historically `orders.priority` was nullable, meaning \"not yet",
    "+triaged.\" Ops has asked for a stable numeric default so downstream",
    "+sorting doesn't need a null-check everywhere.",
    "+\"\"\"",
    "+",
    "+from alembic import op",
    "+",
    "+",
    "+revision = \"0043_backfill_order_priority\"",
    "+down_revision = \"0042_add_order_tags\"",
    "+",
    "+",
    "+def upgrade():",
    "+    op.execute(\"UPDATE orders SET priority = 3 WHERE priority IS NULL\")",
    "+    op.alter_column(\"orders\", \"priority\", server_default=\"3\", nullable=False)",
    "+",
    "+",
    "+def downgrade():",
    "+    op.alter_column(\"orders\", \"priority\", server_default=None, nullable=True)",
    "--- a/src/orders/model.py",
    "+++ b/src/orders/model.py",
    "@@ -2,7 +2,7 @@",
    "     __tablename__ = \"orders\"",
    " ",
    "     id = Column(Integer, primary_key=True)",
    "     customer_id = Column(Integer, ForeignKey(\"customers.id\"), nullable=False)",
    "     status = Column(String, nullable=False, default=\"pending\")",
    "-    priority = Column(Integer, nullable=True)",
    "+    priority = Column(Integer, nullable=False, default=3, server_default=\"3\")",
    "     created_at = Column(DateTime, default=datetime.utcnow)",
    "--- a/src/orders/worker.py",
    "+++ b/src/orders/worker.py",
    "@@ -1,7 +1,8 @@",
    " def process_pending_orders(session):",
    "     orders = session.query(Order).filter(Order.status == \"pending\").all()",
    "+    metrics.gauge(\"orders.pending_batch_size\", len(orders))",
    "     for order in orders:",
    "         if order.priority is None:",
    "             queue_for_manual_triage(order)",
    "             continue",
    "         dispatch_order(order, priority=order.priority)",
    "--- a/tests/test_worker.py",
    "+++ b/tests/test_worker.py",
    "@@ -0,0 +1,24 @@",
    "+import pytest",
    "+",
    "+from orders.worker import process_pending_orders",
    "+",
    "+",
    "+def test_dispatches_pending_orders_with_a_priority(session_factory, order_factory):",
    "+    session = session_factory()",
    "+    order_factory(session, status=\"pending\", priority=1)",
    "+    process_pending_orders(session)",
    "+    assert dispatched_count(session) == 1",
    "+",
    "+",
    "+def test_reports_pending_batch_size_metric(session_factory, order_factory, metrics_spy):",
    "+    session = session_factory()",
    "+    order_factory(session, status=\"pending\", priority=2)",
    "+    process_pending_orders(session)",
    "+    assert metrics_spy.gauge_calls(\"orders.pending_batch_size\") == [1]",
    "+",
    "+",
    "+def test_skips_orders_that_are_not_pending(session_factory, order_factory):",
    "+    session = session_factory()",
    "+    order_factory(session, status=\"shipped\", priority=1)",
    "+    process_pending_orders(session)",
    "+    assert dispatched_count(session) == 0",
    "--- a/CHANGELOG.md",
    "+++ b/CHANGELOG.md",
    "@@ -1,3 +1,7 @@",
    " # Changelog",
    " ",
    " ## Unreleased",
    "+",
    "+- orders.priority is now NOT NULL with a default of 3. Existing NULL",
    "+  rows were backfilled to 3 in the same migration; downstream sorting",
    "+  no longer needs a null-check on priority."
  ],
  "ground_truth": {
    "defect": true,
    "category": "logic-error",
    "accepted_categories": [
      "data-corruption"
    ],
    "severity": [
      "medium",
      "high"
    ],
    "explanation": "process_pending_orders() treats order.priority is None as 'not yet triaged, needs a human' -- that check is unchanged in this diff, shown here only because a metrics line was added next to it. The migration backfills every NULL priority to 3 and makes the column NOT NULL with server default 3, so after this ships priority can never be NULL again, for old or new rows. order.priority is None becomes permanently unreachable dead code, and orders that would have been queued for manual triage instead default to priority 3 and get auto-dispatched. model.py is updated correctly to match the migration, which makes it easy to conclude the schema change is fully handled -- the break is in worker.py's business logic, not the model."
  },
  "difficulty": "cross-file",
  "tags": [
    "true-cross-file",
    "deep-reasoning"
  ]
}
