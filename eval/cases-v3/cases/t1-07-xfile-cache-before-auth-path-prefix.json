{
  "benchmark_version": 2,
  "id": "t1-07-xfile-cache-before-auth-path-prefix",
  "title": "New response cache runs before auth; its prefix check catches an authed route",
  "language": "python",
  "status": "pilot",
  "provenance": {
    "type": "authored-realistic",
    "author_family": "claude"
  },
  "affected_files": [
    "src/app/middleware.py",
    "src/app/cache.py",
    "src/app/routes.py",
    "tests/test_cache_middleware.py",
    "CHANGELOG.md"
  ],
  "diff": [
    "--- a/src/app/middleware.py",
    "+++ b/src/app/middleware.py",
    "@@ -1,7 +1,13 @@",
    " from .auth import auth_middleware",
    "+from .cache import cache_middleware",
    " from .logging import request_log_middleware",
    " ",
    "+# Cache runs before auth: cached responses are for public, unauthenticated",
    "+# paths only, so there is no auth decision to make before serving one --",
    "+# skipping straight to the cache lookup avoids an unnecessary auth check",
    "+# on the hottest, unauthenticated traffic.",
    " MIDDLEWARE_CHAIN = [",
    "     request_log_middleware,",
    "+    cache_middleware,",
    "     auth_middleware,",
    " ]",
    "--- a/src/app/cache.py",
    "+++ b/src/app/cache.py",
    "@@ -0,0 +1,17 @@",
    "+_response_cache = {}",
    "+",
    "+PUBLIC_PATH_PREFIX = \"/api/public\"",
    "+",
    "+",
    "+def cache_middleware(request, next_handler):",
    "+    if request.method != \"GET\" or not request.path.startswith(PUBLIC_PATH_PREFIX):",
    "+        return next_handler(request)",
    "+",
    "+    cached = _response_cache.get(request.path)",
    "+    if cached is not None:",
    "+        return cached",
    "+",
    "+    response = next_handler(request)",
    "+    if response.status_code == 200:",
    "+        _response_cache[request.path] = response",
    "+    return response",
    "--- a/src/app/routes.py",
    "+++ b/src/app/routes.py",
    "@@ -1,3 +1,12 @@",
    " @app.route(\"/api/public/pricing\", methods=[\"GET\"])",
    " def get_pricing():",
    "     return jsonify(pricing_table())",
    "+",
    "+",
    "+@app.route(\"/api/public-profile/edit\", methods=[\"GET\"])",
    "+@require_auth",
    "+def get_profile_edit_form():",
    "+    \"\"\"Pre-filled edit form for the current user's public-facing",
    "+    profile page (display name, bio, avatar) -- requires the user to",
    "+    be logged in as themselves.\"\"\"",
    "+    return jsonify(current_user_profile_edit_data())",
    "--- a/tests/test_cache_middleware.py",
    "+++ b/tests/test_cache_middleware.py",
    "@@ -0,0 +1,24 @@",
    "+import pytest",
    "+",
    "+from app.cache import cache_middleware",
    "+",
    "+",
    "+def test_public_get_is_served_from_cache_on_second_call(request_factory, handler_spy):",
    "+    request = request_factory(method=\"GET\", path=\"/api/public/pricing\")",
    "+    cache_middleware(request, handler_spy)",
    "+    cache_middleware(request, handler_spy)",
    "+    assert handler_spy.call_count == 1",
    "+",
    "+",
    "+def test_non_public_path_bypasses_cache(request_factory, handler_spy):",
    "+    request = request_factory(method=\"GET\", path=\"/api/private/account\")",
    "+    cache_middleware(request, handler_spy)",
    "+    cache_middleware(request, handler_spy)",
    "+    assert handler_spy.call_count == 2",
    "+",
    "+",
    "+def test_post_requests_are_never_cached(request_factory, handler_spy):",
    "+    request = request_factory(method=\"POST\", path=\"/api/public/pricing\")",
    "+    cache_middleware(request, handler_spy)",
    "+    cache_middleware(request, handler_spy)",
    "+    assert handler_spy.call_count == 2",
    "--- a/CHANGELOG.md",
    "+++ b/CHANGELOG.md",
    "@@ -1,3 +1,8 @@",
    " # Changelog",
    " ",
    " ## Unreleased",
    "+",
    "+- Public GET endpoints under /api/public are now cached in-process to",
    "+  cut load on the pricing service during traffic spikes.",
    "+- New endpoint: GET /api/public-profile/edit, a pre-filled edit form",
    "+  for the current user's public profile page."
  ],
  "ground_truth": {
    "defect": true,
    "category": "auth-bypass",
    "accepted_categories": [
      "contract-mismatch"
    ],
    "severity": [
      "high",
      "critical"
    ],
    "explanation": "cache_middleware only caches GET requests whose path starts with '/api/public', which reads as a safe, deliberate public-only guard -- and it is a reasonable guard on its own. The new /api/public-profile/edit route added in routes.py also starts with '/api/public' by pure naming coincidence, but is decorated @require_auth and returns per-user data. Because middleware.py puts cache_middleware before auth_middleware in the chain, the first authenticated user to hit that path gets their profile-edit response cached, and cache_middleware then serves that same cached response to every subsequent caller regardless of who they are or whether auth_middleware would have rejected them -- no single file shows a bug in isolation."
  },
  "difficulty": "cross-file",
  "tags": [
    "auth-bypass",
    "true-cross-file",
    "deep-reasoning"
  ]
}
