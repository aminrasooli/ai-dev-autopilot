{
  "benchmark_version": 2,
  "id": "t2-16-js-inflight-map-poisoned-on-rejection",
  "title": "Fetch dedupe map cleans up on success only; one failure pins the rejection forever",
  "language": "javascript",
  "status": "pilot",
  "provenance": {
    "type": "authored-realistic",
    "author_family": "claude"
  },
  "affected_files": [
    "services/profiles/src/profileCache.js",
    "services/profiles/src/upstream.js",
    "services/profiles/src/routes/profile.js",
    "services/profiles/src/__tests__/profileCache.test.js"
  ],
  "diff": [
    "--- a/services/profiles/src/profileCache.js",
    "+++ b/services/profiles/src/profileCache.js",
    "@@ -2,16 +2,29 @@",
    " ",
    " const TTL_MS = 60_000;",
    " ",
    " const cache = new Map();",
    " ",
    "+// Concurrent requests for the same cold user were each hitting the",
    "+// upstream (a thundering herd on every deploy, when the cache starts",
    "+// empty). Deduplicate: the first caller starts the fetch, everyone",
    "+// else awaits the same promise.",
    "+const inflight = new Map();",
    "+",
    " async function getProfile(userId) {",
    "   const hit = cache.get(userId);",
    "   if (hit && Date.now() - hit.at < TTL_MS) {",
    "     return hit.value;",
    "   }",
    "-  const value = await fetchProfile(userId);",
    "-  cache.set(userId, { value, at: Date.now() });",
    "-  return value;",
    "+  if (inflight.has(userId)) {",
    "+    return inflight.get(userId);",
    "+  }",
    "+  const promise = fetchProfile(userId).then((value) => {",
    "+    cache.set(userId, { value, at: Date.now() });",
    "+    inflight.delete(userId);",
    "+    return value;",
    "+  });",
    "+  inflight.set(userId, promise);",
    "+  return promise;",
    " }",
    " ",
    " module.exports = { getProfile };",
    "--- a/services/profiles/src/upstream.js",
    "+++ b/services/profiles/src/upstream.js",
    "@@ -1,8 +1,12 @@",
    " const http = require(\"./httpClient\");",
    " ",
    "+const FETCH_TIMEOUT_MS = 2_000;",
    "+",
    " async function fetchProfile(userId) {",
    "-  const res = await http.get(`/internal/profiles/${userId}`);",
    "+  const res = await http.get(`/internal/profiles/${userId}`, {",
    "+    timeout: FETCH_TIMEOUT_MS,",
    "+  });",
    "   return res.data;",
    " }",
    " ",
    " module.exports = { fetchProfile };",
    "--- a/services/profiles/src/routes/profile.js",
    "+++ b/services/profiles/src/routes/profile.js",
    "@@ -5,10 +5,11 @@",
    " const router = express.Router();",
    " ",
    " router.get(\"/users/:id/profile\", async (req, res, next) => {",
    "   try {",
    "     const profile = await getProfile(req.params.id);",
    "+    res.set(\"Cache-Control\", \"private, max-age=30\");",
    "     res.json(profile);",
    "   } catch (err) {",
    "     next(err);",
    "   }",
    " });",
    "--- a/services/profiles/src/__tests__/profileCache.test.js",
    "+++ b/services/profiles/src/__tests__/profileCache.test.js",
    "@@ -0,0 +1,34 @@",
    "+const { getProfile } = require(\"../profileCache\");",
    "+const upstream = require(\"../upstream\");",
    "+",
    "+jest.mock(\"../upstream\");",
    "+",
    "+describe(\"profile cache\", () => {",
    "+  test(\"caches a fetched profile\", async () => {",
    "+    upstream.fetchProfile.mockResolvedValue({ id: \"u1\" });",
    "+    await getProfile(\"u1\");",
    "+    await getProfile(\"u1\");",
    "+    expect(upstream.fetchProfile).toHaveBeenCalledTimes(1);",
    "+  });",
    "+",
    "+  test(\"dedupes concurrent cold fetches\", async () => {",
    "+    upstream.fetchProfile.mockResolvedValue({ id: \"u2\" });",
    "+    await Promise.all([getProfile(\"u2\"), getProfile(\"u2\"), getProfile(\"u2\")]);",
    "+    expect(upstream.fetchProfile).toHaveBeenCalledTimes(1);",
    "+  });",
    "+",
    "+  test(\"propagates upstream failures\", async () => {",
    "+    upstream.fetchProfile.mockRejectedValue(new Error(\"upstream down\"));",
    "+    await expect(getProfile(\"u3\")).rejects.toThrow(\"upstream down\");",
    "+  });",
    "+",
    "+  test(\"refetches after the TTL expires\", async () => {",
    "+    jest.useFakeTimers();",
    "+    upstream.fetchProfile.mockResolvedValue({ id: \"u4\" });",
    "+    await getProfile(\"u4\");",
    "+    jest.advanceTimersByTime(61_000);",
    "+    await getProfile(\"u4\");",
    "+    expect(upstream.fetchProfile).toHaveBeenCalledTimes(2);",
    "+    jest.useRealTimers();",
    "+  });",
    "+});"
  ],
  "ground_truth": {
    "defect": true,
    "category": "error-handling",
    "accepted_categories": [
      "concurrency",
      "resource-leak"
    ],
    "severity": [
      "medium",
      "high"
    ],
    "explanation": "The dedupe map entry is deleted inside .then(), which runs only when the fetch RESOLVES. If fetchProfile rejects -- one upstream blip for one user -- the rejected promise stays in the inflight map forever: every later request for that user finds the map entry and awaits the same already-rejected promise, so a single transient failure permanently poisons that user id until the process restarts. (The cache-hit branch can never save it, because the cache is only populated in the same .then that never ran.) The cleanup belongs in .finally(), or the rejection handler must delete the entry too. The lifecycle reasoning -- which continuation runs on which settlement path, and what state each leaves behind -- is exactly what the test suite misses: it tests one failing call in isolation and never a request AFTER a failure.\\n\\nOffline validation (execution_validated): a standalone Node reproduction confirmed that after one rejected fetch, every subsequent call rejects without reaching the upstream, while a .finally()-based variant recovers on the next call. Counts are in the validation note.",
    "execution_validated": true,
    "validation_note": "Standalone Node reproduction: with cleanup in .then only, one rejected fetch left every subsequent request rejecting without reaching the upstream in 100/100 trials; with cleanup moved to .finally, the next request recovered in 100/100. Script and raw output preserved as private provenance, not in this repository.",
    "validation_artifact_sha256": "976e98cc84edb171f0c4997fd38f5b3938a0d024b2c93f0a070553d1ab86f408"
  },
