{
  "benchmark_version": 2,
  "id": "t1-11-clean-narrowed-except-clauses",
  "title": "Clean: three broad except clauses narrowed, one deliberately left broad",
  "language": "python",
  "status": "pilot",
  "provenance": {
    "type": "authored-realistic",
    "author_family": "claude"
  },
  "affected_files": [
    "src/jobs/task_runner.py",
    "tests/test_task_runner.py",
    "CHANGELOG.md"
  ],
  "diff": [
    "--- a/src/jobs/task_runner.py",
    "+++ b/src/jobs/task_runner.py",
    "@@ -1,31 +1,31 @@",
    " def run_scheduled_job(job):",
    "     try:",
    "         job.execute()",
    "-    except Exception as exc:",
    "+    except JobExecutionError as exc:",
    "         logger.error(\"job %s failed: %s\", job.id, exc)",
    "         raise",
    " ",
    " ",
    " def send_notification(user, message):",
    "     try:",
    "         notifier.send(user.contact, message)",
    "-    except Exception as exc:",
    "+    except NotifierUnavailable as exc:",
    "         logger.warning(\"notification failed for %s: %s\", user.id, exc)",
    " ",
    " ",
    " def refresh_cache_entry(key):",
    "     try:",
    "         cache.set(key, compute_value(key))",
    "-    except Exception as exc:",
    "+    except (CacheUnavailable, ValueComputationError) as exc:",
    "         logger.warning(\"cache refresh failed for %s: %s\", key, exc)",
    " ",
    " ",
    " def poll_external_status(job):",
    "     try:",
    "         return status_client.poll(job.external_id)",
    "-    except Exception as exc:",
    "+    except StatusPollTimeout as exc:",
    "         logger.warning(\"status poll failed for job %s: %s\", job.id, exc)",
    "         return None",
    " ",
    " ",
    " def dispatch_request(request):",
    "--- a/tests/test_task_runner.py",
    "+++ b/tests/test_task_runner.py",
    "@@ -1,20 +1,30 @@",
    " import pytest",
    " ",
    "-from jobs.task_runner import run_scheduled_job, send_notification, refresh_cache_entry",
    "+from jobs.exceptions import (",
    "+    JobExecutionError, NotifierUnavailable, CacheUnavailable, StatusPollTimeout,",
    "+)",
    "+from jobs.task_runner import (",
    "+    run_scheduled_job, send_notification, refresh_cache_entry, poll_external_status,",
    "+)",
    " ",
    " ",
    " def test_run_scheduled_job_reraises_after_logging(job_factory, caplog):",
    "-    job = job_factory(fails_with=Exception(\"boom\"))",
    "-    with pytest.raises(Exception):",
    "+    job = job_factory(fails_with=JobExecutionError(\"boom\"))",
    "+    with pytest.raises(JobExecutionError):",
    "         run_scheduled_job(job)",
    "     assert \"failed\" in caplog.text",
    " ",
    " ",
    "-def test_send_notification_swallows_failure(user_factory, notifier_spy):",
    "-    notifier_spy.fail_next()",
    "+def test_send_notification_swallows_expected_failure(user_factory, notifier_spy):",
    "+    notifier_spy.fail_next(NotifierUnavailable)",
    "     send_notification(user_factory(), \"hello\")",
    " ",
    " ",
    "-def test_refresh_cache_entry_swallows_failure(cache_spy):",
    "-    cache_spy.fail_next()",
    "+def test_refresh_cache_entry_swallows_expected_failure(cache_spy):",
    "+    cache_spy.fail_next(CacheUnavailable)",
    "     refresh_cache_entry(\"k\")",
    "+",
    "+",
    "+def test_poll_external_status_swallows_expected_timeout(job_factory, status_client_spy):",
    "+    status_client_spy.fail_next(StatusPollTimeout)",
    "+    assert poll_external_status(job_factory()) is None",
    "--- a/CHANGELOG.md",
    "+++ b/CHANGELOG.md",
    "@@ -1,3 +1,10 @@",
    " # Changelog",
    " ",
    " ## Unreleased",
    "+",
    "+- Narrow the bare `except Exception` in run_scheduled_job,",
    "+  send_notification and refresh_cache_entry to the specific failure",
    "+  types each one actually expects, so an unexpected programming error",
    "+  is no longer logged and swallowed as if it were a routine transient",
    "+  failure. dispatch_request's top-level catch-all is unchanged and",
    "+  stays broad by design."
  ],
  "ground_truth": {
    "defect": false,
    "explanation": "run_scheduled_job, send_notification, refresh_cache_entry and poll_external_status narrow their `except Exception` to the specific expected failure types, which is a correctness improvement: a bare `except Exception` there could silently swallow a programming error (AttributeError, TypeError) as if it were an ordinary transient failure. dispatch_request keeps its `except Exception`, and its docstring -- present before this diff and unchanged -- explains why: it is the documented top-level safety boundary that must never let an unhandled exception take the worker down, and it logs full context and always surfaces a 500 rather than swallowing anything. The one broad catch that remains is the correct one to keep broad."
  },
  "difficulty": "moderate",
  "tags": [
    "hard-clean-control"
  ]
}
