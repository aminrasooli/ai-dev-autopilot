{
  "benchmark_version": 2,
  "id": "t2-04-rust-lease-unit-migration-miss",
  "title": "Config durations migrate from milliseconds to seconds; one call site keeps from_millis",
  "language": "rust",
  "status": "pilot",
  "provenance": {
    "type": "authored-realistic",
    "author_family": "claude"
  },
  "affected_files": [
    "worker/src/config.rs",
    "worker/src/poller.rs",
    "worker/src/config_test.rs"
  ],
  "diff": [
    "--- a/worker/src/config.rs",
    "+++ b/worker/src/config.rs",
    "@@ -1,24 +1,30 @@",
    " use serde::Deserialize;",
    " ",
    "+// Operators kept misreading the *_ms fields as seconds in deployment",
    "+// manifests (a lease_ttl_ms of 30 gave a 30-millisecond lease). All",
    "+// durations are now whole seconds, matching every other service in the",
    "+// fleet; the old field names are rejected so a stale manifest fails",
    "+// loudly at startup instead of silently misbehaving.",
    " #[derive(Debug, Clone, Deserialize)]",
    "+#[serde(deny_unknown_fields)]",
    " pub struct PollerConfig {",
    "-    /// Poll interval in milliseconds.",
    "-    pub poll_interval_ms: u64,",
    "-    /// Per-request timeout in milliseconds.",
    "-    pub request_timeout_ms: u64,",
    "+    /// Poll interval in seconds.",
    "+    pub poll_interval_secs: u64,",
    "+    /// Per-request timeout in seconds.",
    "+    pub request_timeout_secs: u64,",
    "     /// How long a lease is held before another worker may steal it,",
    "-    /// in milliseconds.",
    "-    pub lease_ttl_ms: u64,",
    "+    /// in seconds.",
    "+    pub lease_ttl_secs: u64,",
    "     pub max_inflight: usize,",
    " }",
    " ",
    " impl Default for PollerConfig {",
    "     fn default() -> Self {",
    "         Self {",
    "-            poll_interval_ms: 2_000,",
    "-            request_timeout_ms: 5_000,",
    "-            lease_ttl_ms: 30_000,",
    "+            poll_interval_secs: 2,",
    "+            request_timeout_secs: 5,",
    "+            lease_ttl_secs: 30,",
    "             max_inflight: 8,",
    "         }",
    "     }",
    " }",
    "--- a/worker/src/poller.rs",
    "+++ b/worker/src/poller.rs",
    "@@ -11,29 +11,29 @@",
    "     pub fn new(cfg: PollerConfig, client: JobClient) -> Self {",
    "         Self { cfg, client }",
    "     }",
    " ",
    "     pub async fn run(&self) {",
    "-        let interval = Duration::from_millis(self.cfg.poll_interval_ms);",
    "+        let interval = Duration::from_secs(self.cfg.poll_interval_secs);",
    "         loop {",
    "             match self.poll_once().await {",
    "                 Ok(n) if n > 0 => continue,",
    "                 _ => tokio::time::sleep(interval).await,",
    "             }",
    "         }",
    "     }",
    " ",
    "     async fn poll_once(&self) -> Result<usize, PollError> {",
    "-        let timeout = Duration::from_millis(self.cfg.request_timeout_ms);",
    "+        let timeout = Duration::from_secs(self.cfg.request_timeout_secs);",
    "         let jobs = tokio::time::timeout(timeout, self.client.fetch_ready()).await??;",
    "         for job in &jobs {",
    "             self.claim(job).await?;",
    "         }",
    "         Ok(jobs.len())",
    "     }",
    " ",
    "     async fn claim(&self, job: &Job) -> Result<(), PollError> {",
    "-        let lease = Duration::from_millis(self.cfg.lease_ttl_ms);",
    "+        let lease = Duration::from_millis(self.cfg.lease_ttl_secs);",
    "         self.client.acquire_lease(&job.id, lease).await?;",
    "         self.client.start(job).await",
    "     }",
    " }",
    "--- a/worker/src/config_test.rs",
    "+++ b/worker/src/config_test.rs",
    "@@ -0,0 +1,25 @@",
    "+use crate::config::PollerConfig;",
    "+",
    "+#[test]",
    "+fn defaults_are_sane() {",
    "+    let cfg = PollerConfig::default();",
    "+    assert_eq!(cfg.poll_interval_secs, 2);",
    "+    assert_eq!(cfg.request_timeout_secs, 5);",
    "+    assert_eq!(cfg.lease_ttl_secs, 30);",
    "+}",
    "+",
    "+#[test]",
    "+fn old_millisecond_field_names_are_rejected() {",
    "+    let manifest = r#\"{ \"poll_interval_ms\": 2000, \"request_timeout_ms\": 5000,",
    "+                        \"lease_ttl_ms\": 30000, \"max_inflight\": 8 }\"#;",
    "+    let parsed: Result<PollerConfig, _> = serde_json::from_str(manifest);",
    "+    assert!(parsed.is_err(), \"stale manifests must fail at startup\");",
    "+}",
    "+",
    "+#[test]",
    "+fn new_field_names_parse() {",
    "+    let manifest = r#\"{ \"poll_interval_secs\": 2, \"request_timeout_secs\": 5,",
    "+                        \"lease_ttl_secs\": 30, \"max_inflight\": 8 }\"#;",
    "+    let parsed: PollerConfig = serde_json::from_str(manifest).unwrap();",
    "+    assert_eq!(parsed.lease_ttl_secs, 30);",
    "+}"
  ],
  "ground_truth": {
    "defect": true,
    "category": "logic-error",
    "accepted_categories": [
      "data-corruption"
    ],
    "severity": [
      "high",
      "critical"
    ],
    "explanation": "The unit migration is careful everywhere except one line: claim() builds the lease duration with Duration::from_millis(self.cfg.lease_ttl_secs). Both types are u64 so this compiles cleanly, but a configured 30-second lease becomes a 30-millisecond lease -- another worker can steal a job's lease while the first worker is still running it, so jobs execute concurrently on two workers (duplicate side effects) under any non-trivial load. run() and poll_once() are migrated correctly to from_secs, which makes the one leftover from_millis easy to skim past, and it is the exact operator mistake (ms read as s, factor-of-1000 lease error) that the config comment says this migration exists to prevent. The new tests cover config parsing only; no test exercises the lease duration that claim() actually passes to acquire_lease."
  },
  "difficulty": "subtle",
  "tags": [
    "larger-diff"
  ]
}
