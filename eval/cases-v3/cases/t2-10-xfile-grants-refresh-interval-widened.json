    "+import pytest",
    "+",
    "+from authz.check import has_grant, require_grant, PermissionDenied",
    "+",
    "+",
    "+def test_grant_row_allows_access(grants_view_with):",
    "+    grants_view_with((\"u1\", \"doc-9\", \"read\"))",
    "+    assert has_grant(\"u1\", \"doc-9\", \"read\")",
    "+",
    "+",
    "+def test_missing_grant_denies_access(grants_view_with):",
    "+    grants_view_with((\"u1\", \"doc-9\", \"read\"))",
    "+    assert not has_grant(\"u2\", \"doc-9\", \"read\")",
    "+",
    "+",
    "+def test_require_grant_raises_for_missing_grant(grants_view_with):",
    "+    grants_view_with((\"u1\", \"doc-9\", \"read\"))",
    "+    with pytest.raises(PermissionDenied):",
    "+        require_grant(\"u2\", \"doc-9\", \"read\")",
