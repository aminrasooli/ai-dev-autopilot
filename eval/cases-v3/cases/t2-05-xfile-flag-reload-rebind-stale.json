{
  "benchmark_version": 2,
  "id": "t2-05-xfile-flag-reload-rebind-stale",
  "title": "Hot-reload rebinds the flags global; a from-import consumer never sees updates",
  "language": "python",
  "status": "pilot",
  "provenance": {
    "type": "authored-realistic",
    "author_family": "claude"
  },
  "affected_files": [
    "src/app/features.py",
    "src/app/signals.py",
    "src/app/checkout.py",
    "src/app/api_reports.py",
    "tests/test_features.py"
  ],
  "diff": [
    "--- a/src/app/features.py",
    "+++ b/src/app/features.py",
    "@@ -1,18 +1,34 @@",
    "-\"\"\"Feature flags, loaded once at process start from the flags file.",
    "+\"\"\"Feature flags, hot-reloadable.",
    " ",
    "-Restarting the process is the only way to pick up flag changes.",
    "+On SIGHUP (see app/signals.py) the flags file is re-read and the new",
    "+values take effect on the next check -- no restart needed. Callers",
    "+should read flags through features.is_enabled() or features.FLAGS.",
    " \"\"\"",
    " ",
    " import json",
    "+import logging",
    "+",
    "+logger = logging.getLogger(__name__)",
    " ",
    " ",
    " def _load():",
    "     with open(\"/etc/app/flags.json\", encoding=\"utf-8\") as fh:",
    "         return json.load(fh)",
    " ",
    " ",
    " FLAGS = _load()",
    " ",
    " ",
    "+def reload_flags():",
    "+    global FLAGS",
    "+    new_flags = _load()",
    "+    changed = {k for k in set(FLAGS) | set(new_flags)",
    "+               if FLAGS.get(k) != new_flags.get(k)}",
    "+    FLAGS = new_flags",
    "+    if changed:",
    "+        logger.info(\"flags reloaded, changed: %s\", sorted(changed))",
    "+    return changed",
    "+",
    "+",
    " def is_enabled(name):",
    "     return bool(FLAGS.get(name, False))",
    "--- a/src/app/signals.py",
    "+++ b/src/app/signals.py",
    "@@ -0,0 +1,9 @@",
    "+\"\"\"Process signal wiring.\"\"\"",
    "+",
    "+import signal",
    "+",
    "+from app import features",
    "+",
    "+",
    "+def install(loop):",
    "+    loop.add_signal_handler(signal.SIGHUP, features.reload_flags)",
    "--- a/src/app/checkout.py",
    "+++ b/src/app/checkout.py",
    "@@ -1,9 +1,12 @@",
    " from app.features import FLAGS",
    " ",
    "+from app.metrics import metrics",
    " from app.pricing import quote_with_new_engine, quote_with_legacy_engine",
    " ",
    " ",
    " def build_quote(cart):",
    "     if FLAGS.get(\"new_pricing_engine\"):",
    "+        metrics.incr(\"pricing.new_engine\")",
    "         return quote_with_new_engine(cart)",
    "+    metrics.incr(\"pricing.legacy_engine\")",
    "     return quote_with_legacy_engine(cart)",
    "--- a/src/app/api_reports.py",
    "+++ b/src/app/api_reports.py",
    "@@ -2,8 +2,10 @@",
    " ",
    " from app.export import stream_csv, stream_parquet",
    " ",
    " ",
    " def export_report(request):",
    "+    # Rollout of parquet export is controlled by ops flipping the",
    "+    # flag and sending SIGHUP; no deploy required.",
    "     if features.is_enabled(\"parquet_export\"):",
    "         return stream_parquet(request)",
    "     return stream_csv(request)",
    "--- a/tests/test_features.py",
    "+++ b/tests/test_features.py",
    "@@ -0,0 +1,25 @@",
    "+import json",
    "+",
    "+from app import features",
    "+",
    "+",
    "+def test_is_enabled_reads_current_flags(tmp_flags_file):",
    "+    tmp_flags_file.write(json.dumps({\"parquet_export\": True}))",
    "+    features.reload_flags()",
    "+    assert features.is_enabled(\"parquet_export\")",
    "+",
    "+",
    "+def test_reload_reports_changed_flags(tmp_flags_file):",
    "+    tmp_flags_file.write(json.dumps({\"new_pricing_engine\": True}))",
    "+    changed = features.reload_flags()",
    "+    assert \"new_pricing_engine\" in changed",
    "+",
    "+",
    "+def test_reload_via_module_attribute_sees_new_values(tmp_flags_file):",
    "+    tmp_flags_file.write(json.dumps({\"new_pricing_engine\": True}))",
    "+    features.reload_flags()",
    "+    assert features.FLAGS.get(\"new_pricing_engine\") is True",
    "+",
    "+",
    "+def test_unknown_flag_defaults_to_disabled():",
    "+    assert not features.is_enabled(\"does-not-exist\")"
  ],
  "ground_truth": {
    "defect": true,
    "category": "contract-mismatch",
    "accepted_categories": [
      "logic-error"
    ],
    "severity": [
      "medium",
      "high"
    ],
    "explanation": "reload_flags() rebinds the module global (FLAGS = new_flags) rather than mutating the existing dict. Callers that read through the module attribute -- features.FLAGS or features.is_enabled(), like api_reports.py -- see the new binding on every call and hot-reload works for them. But checkout.py does `from app.features import FLAGS`, which copies the reference at import time: after a reload, checkout keeps checking the OLD dict forever, so the new_pricing_engine flag silently never takes effect (or never turns off) for exactly the checkout path, while flag changes visibly work elsewhere and the reload log line says the change applied. The docstring even sanctions both access patterns ('features.is_enabled() or features.FLAGS'), which reads as if checkout's import were fine. Establishing the bug requires combining the rebind in features.py, the SIGHUP wiring, and checkout.py's import form -- no single file is wrong in isolation."
  },
  "difficulty": "cross-file",
  "tags": [
    "true-cross-file",
    "deep-reasoning"
  ]
}
