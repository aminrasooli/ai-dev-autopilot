    "--- a/services/tickets/src/__tests__/repo.test.ts",
    "+++ b/services/tickets/src/__tests__/repo.test.ts",
    "@@ -0,0 +1,22 @@",
    "+import { listTickets } from \"../repo/tickets\";",
    "+import { seedTicket, resetDb } from \"./helpers\";",
    "+",
    "+describe(\"listTickets\", () => {",
    "+  beforeEach(resetDb);",
    "+",
    "+  test(\"orders by most recently updated first\", async () => {",
    "+    await seedTicket(\"p1\", { createdDaysAgo: 30, updatedDaysAgo: 1 });",
    "+    await seedTicket(\"p1\", { createdDaysAgo: 2, updatedDaysAgo: 10 });",
    "+    const page = await listTickets(\"p1\");",
    "+    expect(page[0].updated_at.getTime()).toBeGreaterThan(",
    "+      page[1].updated_at.getTime()",
    "+    );",
    "+  });",
    "+",
    "+  test(\"a freshly-commented old ticket floats to the top\", async () => {",
    "+    const old = await seedTicket(\"p1\", { createdDaysAgo: 90, updatedDaysAgo: 0 });",
    "+    await seedTicket(\"p1\", { createdDaysAgo: 1, updatedDaysAgo: 5 });",
    "+    const page = await listTickets(\"p1\");",
    "+    expect(page[0].id).toBe(old.id);",
    "+  });",
    "+});"
