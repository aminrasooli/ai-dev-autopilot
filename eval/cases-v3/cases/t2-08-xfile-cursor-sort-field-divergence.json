    "+import { getTickets } from \"../handlers/tickets\";",
    "+import { makeReqRes, seedTickets } from \"./helpers\";",
    "+",
    "+describe(\"GET /projects/:projectId/tickets\", () => {",
    "+  test(\"returns the first page with a cursor\", async () => {",
    "+    await seedTickets(\"p1\", 3);",
    "+    const { req, res } = makeReqRes({ projectId: \"p1\" });",
    "+    await getTickets(req, res);",
    "+    expect(res.body.tickets).toHaveLength(3);",
    "+    expect(res.body.nextCursor).not.toBeNull();",
    "+  });",
    "+",
    "+  test(\"rejects an oversized cursor instead of crashing\", async () => {",
    "+    const { req, res } = makeReqRes(",
    "+      { projectId: \"p1\" },",
    "+      { cursor: \"x\".repeat(500) }",
    "+    );",
    "+    await getTickets(req, res);",
    "+    expect(res.statusCode).toBe(200);",
    "+  });",
    "+",
    "+  test(\"returns an empty page for an unknown project\", async () => {",
    "+    const { req, res } = makeReqRes({ projectId: \"nope\" });",
    "+    await getTickets(req, res);",
    "+    expect(res.body.tickets).toHaveLength(0);",
    "+    expect(res.body.nextCursor).toBeNull();",
