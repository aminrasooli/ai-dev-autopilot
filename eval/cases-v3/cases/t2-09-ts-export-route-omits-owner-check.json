    "+import request from \"supertest\";",
    "+",
    "+import { makeApp, seedRecord, asUser } from \"./helpers\";",
    "+",
    "+describe(\"GET /records/:id/export\", () => {",
    "+  test(\"exports the record as CSV\", async () => {",
    "+    const record = await seedRecord({ ownerId: \"u1\" });",
    "+    const res = await asUser(\"u1\")",
    "+      .get(`/records/${record.id}/export`)",
    "+      .expect(200);",
    "+    expect(res.headers[\"content-type\"]).toContain(\"text/csv\");",
    "+    expect(res.text).toContain(record.id);",
    "+  });",
    "+",
    "+  test(\"is rate limited\", async () => {",
    "+    const record = await seedRecord({ ownerId: \"u1\" });",
    "+    for (let i = 0; i < 5; i++) {",
    "+      await asUser(\"u1\").get(`/records/${record.id}/export`).expect(200);",
    "+    }",
    "+    await asUser(\"u1\").get(`/records/${record.id}/export`).expect(429);",
    "+  });",
    "+",
    "+  test(\"returns 404 for a missing record\", async () => {",
    "+    await asUser(\"u1\").get(\"/records/nope/export\").expect(404);",
    "+  });",
    "+});"
