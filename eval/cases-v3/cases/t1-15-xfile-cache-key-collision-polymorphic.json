    "-        attachments = self._load_attachments()",
    "-        cache.set(key, attachments, ttl=600)",
    "-        return attachments",
    "-",
    "-    def invalidate_attachments_cache(self):",
    "-        cache.delete(self.cache_key())",
    "-",
    "     def _load_attachments(self):",
    "         return db.query(Attachment).filter_by(owner_type=\"comment\", owner_id=self.id).all()",
    "--- a/src/models/task.py",
