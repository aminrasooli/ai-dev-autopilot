    "--- a/tests/test_cacheable.py",
    "+++ b/tests/test_cacheable.py",
    "@@ -0,0 +1,25 @@",
    "+import pytest",
    "+",
    "+from models.comment import Comment",
    "+from models.task import Task",
    "+",
    "+",
    "+def test_comment_caches_its_own_attachments(db_factory):",
    "+    comment = Comment(id=1, body=\"hi\")",
    "+    first = comment.cached_attachments()",
    "+    second = comment.cached_attachments()",
    "+    assert first == second",
    "+",
    "+",
    "+def test_task_caches_its_own_attachments(db_factory):",
    "+    task = Task(id=1, title=\"ship it\")",
    "+    first = task.cached_attachments()",
    "+    second = task.cached_attachments()",
    "+    assert first == second",
    "+",
    "+",
    "+def test_invalidate_clears_the_cached_value(db_factory):",
    "+    comment = Comment(id=2, body=\"hi\")",
    "+    comment.cached_attachments()",
    "+    comment.invalidate_attachments_cache()",
    "+    assert cache.get(comment.cache_key()) is None"
