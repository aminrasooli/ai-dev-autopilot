  "diff": [
    "--- a/src/models/cacheable.py",
    "+++ b/src/models/cacheable.py",
    "@@ -0,0 +1,19 @@",
    "+class CacheableMixin:",
    "+    \"\"\"Shared caching behavior for models with an attachments list.",
    "+    Every model using this mixin gets get/set/invalidate for free",
    "+    instead of hand-rolling its own cache_key method.\"\"\"",
    "+",
    "+    def cache_key(self):",
    "+        return f\"attachments:{self.id}\"",
    "+",
    "+    def cached_attachments(self):",
    "+        key = self.cache_key()",
    "+        cached = cache.get(key)",
    "+        if cached is not None:",
    "+            return cached",
    "+        attachments = self._load_attachments()",
    "+        cache.set(key, attachments, ttl=600)",
    "+        return attachments",
    "+",
    "+    def invalidate_attachments_cache(self):",
    "+        cache.delete(self.cache_key())",
    "--- a/src/models/comment.py",
    "+++ b/src/models/comment.py",
    "@@ -1,23 +1,8 @@",
    "-class Comment(Base):",
