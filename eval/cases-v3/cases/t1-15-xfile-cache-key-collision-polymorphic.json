    "     __tablename__ = \"comments\"",
    " ",
    "     id = Column(Integer, primary_key=True)",
    "     body = Column(Text, nullable=False)",
    " ",
    "-    def cache_key(self):",
    "-        return f\"attachments:comment:{self.id}\"",
    "-",
    "-    def cached_attachments(self):",
    "-        key = self.cache_key()",
    "-        cached = cache.get(key)",
    "-        if cached is not None:",
