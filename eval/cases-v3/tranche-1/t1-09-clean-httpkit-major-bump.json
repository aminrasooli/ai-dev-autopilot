{
  "benchmark_version": 2,
  "id": "t1-09-clean-httpkit-major-bump",
  "title": "Clean: httpkit v2 -> v3 bump, every wait-forever call site migrated",
  "language": "python",
  "status": "pilot",
  "provenance": {
    "type": "authored-realistic",
    "author_family": "claude"
  },
  "affected_files": [
    "requirements.txt",
    "src/integrations/webhook_sender.py",
    "src/integrations/report_export.py",
    "src/integrations/partner_sync.py",
    "src/integrations/health_check.py",
    "tests/test_httpkit_migration.py",
    "CHANGELOG.md"
  ],
  "diff": [
    "--- a/requirements.txt",
    "+++ b/requirements.txt",
    "@@ -1,3 +1,3 @@",
    " flask==2.3.3",
    "-httpkit==2.4.1",
    "+httpkit==3.0.0",
    " sqlalchemy==2.0.19",
    "--- a/src/integrations/webhook_sender.py",
    "+++ b/src/integrations/webhook_sender.py",
    "@@ -1,8 +1,10 @@",
    " import httpkit",
    " ",
    " ",
    " def send_webhook(url, payload):",
    "     # Webhooks may legitimately take a long time on a slow receiver;",
    "-    # never give up on the caller's behalf.",
    "-    resp = httpkit.post(url, json=payload, timeout=None)",
    "+    # never give up on the caller's behalf. httpkit 3.x changed the",
    "+    # meaning of timeout=None from \"wait forever\" to \"use the 30s",
    "+    # default\", so waiting forever now needs the explicit sentinel.",
    "+    resp = httpkit.post(url, json=payload, timeout=httpkit.NO_TIMEOUT)",
    "     return resp.status_code",
    "--- a/src/integrations/report_export.py",
    "+++ b/src/integrations/report_export.py",
    "@@ -1,6 +1,8 @@",
    " import httpkit",
    " ",
    " ",
    " def upload_report(url, report_bytes):",
    "-    resp = httpkit.put(url, data=report_bytes, timeout=None)",
    "+    # Large report uploads can run long on a slow object-store backend;",
    "+    # same httpkit 3.x sentinel change as webhook_sender.py.",
    "+    resp = httpkit.put(url, data=report_bytes, timeout=httpkit.NO_TIMEOUT)",
    "     resp.raise_for_status()",
    "--- a/src/integrations/partner_sync.py",
    "+++ b/src/integrations/partner_sync.py",
    "@@ -1,6 +1,6 @@",
    " import httpkit",
    " ",
    " ",
    " def push_partner_update(url, record):",
    "-    resp = httpkit.post(url, json=record, timeout=None)",
    "+    resp = httpkit.post(url, json=record, timeout=httpkit.NO_TIMEOUT)",
    "     return resp.ok",
    "--- a/src/integrations/health_check.py",
    "+++ b/src/integrations/health_check.py",
    "@@ -1,6 +1,8 @@",
    " import httpkit",
    " ",
    " ",
    " def check_upstream_health(url):",
    "-    resp = httpkit.get(url, timeout=5)",
    "+    # httpkit 3.x adds a first-class retry policy; use it instead of",
    "+    # our own hand-rolled loop for this low-stakes probe.",
    "+    resp = httpkit.get(url, timeout=5, retry=httpkit.RetryPolicy(attempts=2))",
    "     return resp.status_code == 200",
    "--- a/tests/test_httpkit_migration.py",
    "+++ b/tests/test_httpkit_migration.py",
    "@@ -0,0 +1,21 @@",
    "+import httpkit",
    "+import pytest",
    "+",
    "+from integrations.webhook_sender import send_webhook",
    "+from integrations.report_export import upload_report",
    "+from integrations.partner_sync import push_partner_update",
    "+",
    "+",
    "+def test_webhook_send_uses_no_timeout_sentinel(httpkit_spy):",
    "+    send_webhook(\"https://example.com/hook\", {\"ok\": True})",
    "+    assert httpkit_spy.last_call_kwargs[\"timeout\"] is httpkit.NO_TIMEOUT",
    "+",
    "+",
    "+def test_report_upload_uses_no_timeout_sentinel(httpkit_spy):",
    "+    upload_report(\"https://example.com/reports\", b\"data\")",
    "+    assert httpkit_spy.last_call_kwargs[\"timeout\"] is httpkit.NO_TIMEOUT",
    "+",
    "+",
    "+def test_partner_sync_uses_no_timeout_sentinel(httpkit_spy):",
    "+    push_partner_update(\"https://partner.example.com\", {\"id\": 1})",
    "+    assert httpkit_spy.last_call_kwargs[\"timeout\"] is httpkit.NO_TIMEOUT",
    "--- a/CHANGELOG.md",
    "+++ b/CHANGELOG.md",
    "@@ -1,3 +1,9 @@",
    " # Changelog",
    " ",
    " ## Unreleased",
    "+",
    "+- Bump httpkit 2.4.1 -> 3.0.0. Breaking change: `timeout=None` no",
    "+  longer means \"wait forever\"; it now means \"use the library's 30s",
    "+  default\". Every call site that relied on the old wait-forever",
    "+  behavior now passes `timeout=httpkit.NO_TIMEOUT` explicitly. Call",
    "+  sites with an explicit numeric timeout are unaffected."
  ],
  "ground_truth": {
    "defect": false,
    "explanation": "httpkit 3.0.0 changed timeout=None from 'wait forever' to 'use the 30s default'. All three call sites that relied on waiting forever (webhook_sender.py, report_export.py, partner_sync.py) are migrated to the new httpkit.NO_TIMEOUT sentinel, preserving their original behavior exactly. health_check.py's explicit timeout=5 was never affected by the change and is updated only to adopt the new retry API, which is used correctly. A large diff touching a major dependency bump and five files, but every call site's behavior after the bump matches its behavior before."
  },
  "difficulty": "subtle",
  "tags": [
    "hard-clean-control",
    "dependency-bump"
  ]
}
