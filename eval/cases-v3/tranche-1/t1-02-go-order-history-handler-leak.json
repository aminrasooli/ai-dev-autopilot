  "diff": [
    "--- a/internal/api/orders.go",
    "+++ b/internal/api/orders.go",
    "@@ -7,19 +7,36 @@",
    " \t\"time\"",
    " )",
    " ",
    " var upstreamClient = &http.Client{Timeout: 5 * time.Second}",
    " ",
    "+func fetchOrder(url string) (*http.Response, error) {",
