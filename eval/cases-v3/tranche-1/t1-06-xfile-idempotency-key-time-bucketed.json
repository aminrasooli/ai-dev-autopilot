  "diff": [
    "--- a/src/payments/idempotency.py",
    "+++ b/src/payments/idempotency.py",
    "@@ -1,9 +1,10 @@",
    " import hashlib",
    " ",
    " ",
    " def build_idempotency_key(request):",
    "-    \"\"\"Stable key for a payment request: identical retries of the same",
    "-    logical charge must always produce the same key, so the payment",
    "-    processor can safely dedupe them.\"\"\"",
    "-    raw = f\"{request.user_id}:{request.order_id}:{request.amount_cents}\"",
    "+    \"\"\"Key for a payment request, bucketed to the current minute so the",
    "+    new per-minute rate limiter (see rate_limit.py) can group requests",
    "+    without a separate cache.\"\"\"",
    "+    bucket = request.submitted_at.strftime(\"%Y%m%dT%H%M\")",
    "+    raw = f\"{request.user_id}:{request.order_id}:{request.amount_cents}:{bucket}\"",
    "     return hashlib.sha256(raw.encode()).hexdigest()",
    "--- a/src/payments/rate_limit.py",
    "+++ b/src/payments/rate_limit.py",
    "@@ -0,0 +1,15 @@",
    "+from collections import defaultdict",
    "+",
    "+from .idempotency import build_idempotency_key",
    "+",
    "+_bucket_counts = defaultdict(int)",
    "+MAX_REQUESTS_PER_MINUTE = 5",
    "+",
    "+",
    "+def check_rate_limit(request):",
    "+    \"\"\"Reject a payment request if this user has already submitted too",
    "+    many distinct requests in the current minute bucket.\"\"\"",
    "+    key = build_idempotency_key(request)",
    "+    _bucket_counts[key] += 1",
    "+    if _bucket_counts[key] > MAX_REQUESTS_PER_MINUTE:",
    "+        raise RateLimitExceeded(f\"too many payment attempts for {request.user_id}\")",
    "--- a/src/payments/retry.py",
    "+++ b/src/payments/retry.py",
    "@@ -1,10 +1,11 @@",
    " from .idempotency import build_idempotency_key",
    " ",
    " ",
    " def submit_with_retry(processor, request, max_attempts=3):",
    "     key = build_idempotency_key(request)",
    "+    logger.info(\"submitting payment for order %s with key %s\", request.order_id, key)",
    "     for attempt in range(max_attempts):",
    "         try:",
    "             return processor.charge(idempotency_key=key, amount_cents=request.amount_cents)",
    "         except TransientProcessorError:",
    "             time.sleep(2 ** attempt)",
    "--- a/tests/test_rate_limit.py",
    "+++ b/tests/test_rate_limit.py",
    "@@ -0,0 +1,25 @@",
    "+import pytest",
    "+",
    "+from payments.rate_limit import check_rate_limit, MAX_REQUESTS_PER_MINUTE",
    "+",
    "+",
    "+def test_allows_requests_under_the_limit(request_factory):",
    "+    request = request_factory(user_id=\"u1\", order_id=\"o1\", amount_cents=500)",
    "+    for _ in range(MAX_REQUESTS_PER_MINUTE):",
    "+        check_rate_limit(request)",
    "+",
    "+",
    "+def test_rejects_requests_over_the_limit(request_factory):",
    "+    request = request_factory(user_id=\"u2\", order_id=\"o2\", amount_cents=500)",
    "+    for _ in range(MAX_REQUESTS_PER_MINUTE):",
    "+        check_rate_limit(request)",
    "+    with pytest.raises(RateLimitExceeded):",
    "+        check_rate_limit(request)",
    "+",
    "+",
    "+def test_different_users_have_independent_buckets(request_factory):",
    "+    a = request_factory(user_id=\"u3\", order_id=\"o3\", amount_cents=500)",
    "+    b = request_factory(user_id=\"u4\", order_id=\"o4\", amount_cents=500)",
    "+    for _ in range(MAX_REQUESTS_PER_MINUTE):",
    "+        check_rate_limit(a)",
    "+    check_rate_limit(b)",
    "--- a/CHANGELOG.md",
    "+++ b/CHANGELOG.md",
    "@@ -1,3 +1,6 @@",
    " # Changelog",
    " ",
    " ## Unreleased",
    "+",
    "+- New per-minute rate limit on payment submission attempts, 5 requests",
    "+  per user per minute, to blunt card-testing abuse."
