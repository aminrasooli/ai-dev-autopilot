  "ground_truth": {
    "defect": true,
    "category": "logic-error",
    "accepted_categories": [
      "contract-mismatch"
    ],
    "severity": [
      "high",
      "critical"
    ],
    "explanation": "build_idempotency_key's docstring changes from 'identical retries must always produce the same key' to describing a per-minute bucket, and rate_limit.py is a new, legitimate caller that wants exactly that bucketing. But retry.py still relies on the old contract: the key is stable only within one submit_with_retry() call, not across a caller re-issuing a fresh request after the whole call fails (a user re-clicking 'retry payment', or a cron re-driving a failed submission). If that new request is created a minute or more after the original, it now gets a different idempotency key and the payment processor treats it as a brand-new charge instead of deduping against the original attempt -- a double charge."
  },
