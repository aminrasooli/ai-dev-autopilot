{
  "benchmark_version": 2,
  "id": "t1-10-clean-auth-decorator-consolidation",
  "title": "Clean: five inline admin checks consolidated into one require_role decorator",
  "language": "python",
  "status": "pilot",
  "provenance": {
    "type": "authored-realistic",
    "author_family": "claude"
  },
  "affected_files": [
    "src/app/routes_billing.py",
    "src/auth/decorators.py",
    "tests/test_routes_billing_auth.py"
  ],
  "diff": [
    "--- a/src/app/routes_billing.py",
    "+++ b/src/app/routes_billing.py",
    "@@ -1,38 +1,26 @@",
    "+from auth.decorators import require_role",
    "+",
    "+",
    "+@require_role(\"admin\")",
    " def edit_billing(request):",
    "-    if not request.user or not request.user.is_authenticated:",
    "-        return Response(status=403)",
    "-    if request.user.role != \"admin\":",
    "-        return Response(status=403)",
    "     return _render_billing_form(request)",
    " ",
    " ",
    "+@require_role(\"admin\", \"auditor\")",
    " def view_audit_log(request):",
    "-    if not request.user.is_authenticated:",
    "-        abort(403)",
    "-    if request.user.role not in (\"admin\", \"auditor\"):",
    "-        abort(403)",
    "     return _render_audit_log(request)",
    " ",
    " ",
    "+@require_role(\"admin\")",
    " def rotate_api_key(request):",
    "-    if not (request.user and request.user.is_authenticated and request.user.role == \"admin\"):",
    "-        return Response(status=403)",
    "     return _rotate_key(request)",
    " ",
    " ",
    "+@require_role(\"admin\")",
    " def export_customer_data(request):",
    "-    if not request.user or not request.user.is_authenticated:",
    "-        abort(403)",
    "-    if request.user.role != \"admin\":",
    "-        abort(403)",
    "     return _export(request)",
    " ",
    " ",
    "+@require_role(\"admin\", \"auditor\")",
    " def view_billing_history(request):",
    "-    if request.user is None:",
    "-        return Response(status=403)",
    "-    if not request.user.is_authenticated:",
    "-        return Response(status=403)",
    "-    if request.user.role != \"admin\" and request.user.role != \"auditor\":",
    "-        return Response(status=403)",
    "     return _render_billing_history(request)",
    "--- a/src/auth/decorators.py",
    "+++ b/src/auth/decorators.py",
    "@@ -0,0 +1,16 @@",
    "+from functools import wraps",
    "+",
    "+from .http import abort",
    "+",
    "+",
    "+def require_role(*allowed_roles):",
    "+    def decorator(handler):",
    "+        @wraps(handler)",
    "+        def wrapped(request, *args, **kwargs):",
    "+            if not request.user or not request.user.is_authenticated:",
    "+                abort(401)",
    "+            if request.user.role not in allowed_roles:",
    "+                abort(403)",
    "+            return handler(request, *args, **kwargs)",
    "+        return wrapped",
    "+    return decorator",
    "--- a/tests/test_routes_billing_auth.py",
    "+++ b/tests/test_routes_billing_auth.py",
    "@@ -0,0 +1,29 @@",
    "+import pytest",
    "+",
    "+from app import routes_billing",
    "+",
    "+",
    "+ADMIN_ONLY = [routes_billing.edit_billing, routes_billing.rotate_api_key,",
    "+              routes_billing.export_customer_data]",
    "+ADMIN_OR_AUDITOR = [routes_billing.view_audit_log, routes_billing.view_billing_history]",
    "+",
    "+",
    "+@pytest.mark.parametrize(\"handler\", ADMIN_ONLY)",
    "+def test_admin_only_handlers_reject_auditor(handler, request_factory):",
    "+    request = request_factory(role=\"auditor\")",
    "+    response = handler(request)",
    "+    assert response.status == 403",
    "+",
    "+",
    "+@pytest.mark.parametrize(\"handler\", ADMIN_ONLY + ADMIN_OR_AUDITOR)",
    "+def test_all_handlers_reject_anonymous(handler, request_factory):",
    "+    request = request_factory(user=None)",
    "+    response = handler(request)",
    "+    assert response.status in (401, 403)",
    "+",
    "+",
    "+@pytest.mark.parametrize(\"handler\", ADMIN_OR_AUDITOR)",
    "+def test_admin_or_auditor_handlers_accept_auditor(handler, request_factory):",
    "+    request = request_factory(role=\"auditor\")",
    "+    response = handler(request)",
    "+    assert response.status == 200"
  ],
  "ground_truth": {
    "defect": false,
    "explanation": "Each of the five handlers had a slightly differently worded but functionally equivalent inline admin (or admin-or-auditor) check, some returning a bare 403 for both unauthenticated and wrong-role callers. The new require_role decorator reproduces the same allowed-role set per handler (view_audit_log and the new view_billing_history correctly get both 'admin' and 'auditor') and, if anything, tightens behavior slightly by returning 401 for unauthenticated callers instead of reusing 403 for both cases -- a stricter, not weaker, result. Every route keeps exactly the protection level it had before, despite touching every previously-inline auth check in the file."
  },
  "difficulty": "subtle",
  "tags": [
    "hard-clean-control"
  ]
}
