{
  "benchmark_version": 2,
  "id": "t1-04-xfile-plan-limit-stale-tier-field",
  "title": "Per-plan upload limits: one caller keys off the legacy tier field",
  "language": "python",
  "status": "pilot",
  "provenance": {
    "type": "authored-realistic",
    "author_family": "claude"
  },
  "affected_files": [
    "src/billing/config.py",
    "src/uploads/quota.py",
    "src/jobs/bulk_export.py",
    "tests/test_quota.py",
    "CHANGELOG.md"
  ],
  "diff": [
    "--- a/src/billing/config.py",
    "+++ b/src/billing/config.py",
    "@@ -1,4 +1,11 @@",
    " \"\"\"Billing and quota configuration.\"\"\"",
    " ",
    "-# Maximum single-upload size, applied uniformly regardless of plan.",
    "-UPLOAD_LIMITS_MB = 50",
    "+# Per-plan maximum single-upload size, in megabytes. Keyed by",
    "+# `user.plan` -- the canonical entitlement field since the 2024 billing",
    "+# migration. `user.tier` is the older analytics-only field and is not",
    "+# an entitlement source; every quota check must key off `user.plan`.",
    "+UPLOAD_LIMITS_MB = {",
    "+    \"free\": 50,",
    "+    \"pro\": 500,",
    "+    \"enterprise\": 2000,",
    "+}",
    "--- a/src/uploads/quota.py",
    "+++ b/src/uploads/quota.py",
    "@@ -1,8 +1,10 @@",
    " from billing import config",
    " ",
    " ",
    " def check_upload_allowed(user, file_size_mb):",
    "-    if file_size_mb > config.UPLOAD_LIMITS_MB:",
    "+    limit_mb = config.UPLOAD_LIMITS_MB.get(user.plan, config.UPLOAD_LIMITS_MB[\"free\"])",
    "+    if file_size_mb > limit_mb:",
    "         raise QuotaExceeded(",
    "-            f\"upload of {file_size_mb}MB exceeds the {config.UPLOAD_LIMITS_MB}MB limit\"",
    "+            f\"upload of {file_size_mb}MB exceeds the {limit_mb}MB limit \"",
    "+            f\"for plan {user.plan!r}\"",
    "         )",
    "--- a/src/jobs/bulk_export.py",
    "+++ b/src/jobs/bulk_export.py",
    "@@ -3,11 +3,11 @@",
    " ",
    " def export_for_user(user, payload_mb):",
    "     \"\"\"Nightly batch export; enforces the same cap as interactive",
    "     uploads so a single scheduled job can't blow past the",
    "     platform-wide limit.\"\"\"",
    "-    if payload_mb > config.UPLOAD_LIMITS_MB:",
    "+    limit_mb = config.UPLOAD_LIMITS_MB.get(user.tier, 50)",
    "+    if payload_mb > limit_mb:",
    "         raise QuotaExceeded(",
    "-            f\"export payload {payload_mb}MB exceeds the \"",
    "-            f\"{config.UPLOAD_LIMITS_MB}MB limit\"",
    "+            f\"export payload {payload_mb}MB exceeds the {limit_mb}MB limit\"",
    "         )",
    "     _run_export(user, payload_mb)",
    "--- a/tests/test_quota.py",
    "+++ b/tests/test_quota.py",
    "@@ -0,0 +1,25 @@",
    "+import pytest",
    "+",
    "+from uploads.quota import check_upload_allowed",
    "+",
    "+",
    "+def test_free_plan_allows_upload_under_limit(user_factory):",
    "+    user = user_factory(plan=\"free\")",
    "+    check_upload_allowed(user, file_size_mb=40)",
    "+",
    "+",
    "+def test_free_plan_rejects_upload_over_limit(user_factory):",
    "+    user = user_factory(plan=\"free\")",
    "+    with pytest.raises(QuotaExceeded):",
    "+        check_upload_allowed(user, file_size_mb=60)",
    "+",
    "+",
    "+def test_enterprise_plan_allows_large_upload(user_factory):",
    "+    user = user_factory(plan=\"enterprise\")",
    "+    check_upload_allowed(user, file_size_mb=1500)",
    "+",
    "+",
    "+def test_pro_plan_rejects_upload_over_its_limit(user_factory):",
    "+    user = user_factory(plan=\"pro\")",
    "+    with pytest.raises(QuotaExceeded):",
    "+        check_upload_allowed(user, file_size_mb=600)",
    "--- a/CHANGELOG.md",
    "+++ b/CHANGELOG.md",
    "@@ -1,3 +1,7 @@",
    " # Changelog",
    " ",
    " ## Unreleased",
    "+",
    "+- Upload limits are now per-plan instead of a flat 50MB for everyone:",
    "+  free stays 50MB, pro moves to 500MB, enterprise to 2000MB. Applies to",
    "+  interactive uploads and the nightly batch export job."
  ],
  "ground_truth": {
    "defect": true,
    "category": "contract-mismatch",
    "accepted_categories": [
      "logic-error"
    ],
    "severity": [
      "medium",
      "high"
    ],
    "explanation": "config.py turns UPLOAD_LIMITS_MB into a per-plan dict and its own comment states user.plan is the canonical entitlement field, with user.tier explicitly called out as legacy/analytics-only. quota.py is updated correctly, keying off user.plan. bulk_export.py is also touched in this diff but keys off user.tier instead, with a `50` fallback -- since user.tier is the legacy field, .get(user.tier, 50) resolves to the free-tier limit for effectively every user, so pro and enterprise customers' nightly batch exports get silently capped at 50MB with no error, no crash, and no sign anything is wrong beyond the export size result."
  },
  "difficulty": "cross-file",
  "tags": [
    "true-cross-file",
    "deep-reasoning"
  ]
}
