{
  "benchmark_version": 2,
  "id": "t1-03-ts-cart-reducer-inplace-mutation",
  "title": "Cart reducer split into handlers; quantity update mutates state in place",
  "language": "typescript",
  "status": "pilot",
  "provenance": {
    "type": "authored-realistic",
    "author_family": "claude"
  },
  "affected_files": [
    "src/store/cart/types.ts",
    "src/store/cart/reducer.ts",
    "src/store/cart/selectors.ts",
    "src/store/cart/index.ts",
    "src/store/cart/reducer.test.ts"
  ],
  "diff": [
    "--- a/src/store/cart/types.ts",
    "+++ b/src/store/cart/types.ts",
    "@@ -0,0 +1,22 @@",
    "+export interface CartItem {",
    "+  sku: string;",
    "+  name: string;",
    "+  unitPrice: number;",
    "+  quantity: number;",
    "+  giftMessage?: string;",
    "+}",
    "+",
    "+export interface CartState {",
    "+  items: CartItem[];",
    "+  couponCode: string | null;",
    "+  updatedAt: number;",
    "+}",
    "+",
    "+export type CartAction =",
    "+  | { type: \"ADD_ITEM\"; item: CartItem }",
    "+  | { type: \"REMOVE_ITEM\"; sku: string }",
    "+  | { type: \"UPDATE_QUANTITY\"; sku: string; quantity: number }",
    "+  | { type: \"APPLY_COUPON\"; code: string }",
    "+  | { type: \"SET_GIFT_MESSAGE\"; sku: string; message: string }",
    "+  | { type: \"MERGE_GUEST_CART\"; guestItems: CartItem[] }",
    "+  | { type: \"CLEAR_CART\" };",
    "--- a/src/store/cart/reducer.ts",
    "+++ b/src/store/cart/reducer.ts",
    "@@ -1,41 +1,88 @@",
    "-import { CartState, CartAction } from \"./types\";",
    "+import { CartState, CartAction, CartItem } from \"./types\";",
    " ",
    " const initialState: CartState = {",
    "   items: [],",
    "   couponCode: null,",
    "   updatedAt: 0,",
    " };",
    " ",
    "+function touch(_state: CartState): number {",
    "+  return Date.now();",
    "+}",
    "+",
    "+function addItem(state: CartState, item: CartItem): CartState {",
    "+  const existing = state.items.find((i) => i.sku === item.sku);",
    "+  const items = existing",
    "+    ? state.items.map((i) =>",
    "+        i.sku === item.sku ? { ...i, quantity: i.quantity + item.quantity } : i",
    "+      )",
    "+    : [...state.items, item];",
    "+  return { ...state, items, updatedAt: touch(state) };",
    "+}",
    "+",
    "+function removeItem(state: CartState, sku: string): CartState {",
    "+  const items = state.items.filter((i) => i.sku !== sku);",
    "+  return { ...state, items, updatedAt: touch(state) };",
    "+}",
    "+",
    "+// Quantity updates are hot-path (stepper clicks in the cart drawer), so",
    "+// this looks the item up once instead of mapping over the whole array.",
    "+function updateQuantity(state: CartState, sku: string, quantity: number): CartState {",
    "+  const item = state.items.find((i) => i.sku === sku);",
    "+  if (item) {",
    "+    item.quantity = quantity;",
    "+  }",
    "+  return { ...state, items: state.items, updatedAt: touch(state) };",
    "+}",
    "+",
    "+function applyCoupon(state: CartState, code: string): CartState {",
    "+  return { ...state, couponCode: code, updatedAt: touch(state) };",
    "+}",
    "+",
    "+function setGiftMessage(state: CartState, sku: string, message: string): CartState {",
    "+  const items = state.items.map((i) =>",
    "+    i.sku === sku ? { ...i, giftMessage: message } : i",
    "+  );",
    "+  return { ...state, items, updatedAt: touch(state) };",
    "+}",
    "+",
    "+function clearCart(state: CartState): CartState {",
    "+  return { ...state, items: [], couponCode: null, updatedAt: touch(state) };",
    "+}",
    "+",
    "+// Runs once at login, when a guest has items in a local cart that need",
    "+// folding into the account's server-backed cart. Duplicate SKUs sum",
    "+// their quantities, same rule as addItem.",
    "+function mergeGuestCart(state: CartState, guestItems: CartItem[]): CartState {",
    "+  let items = state.items;",
    "+  for (const guestItem of guestItems) {",
    "+    const existing = items.find((i) => i.sku === guestItem.sku);",
    "+    items = existing",
    "+      ? items.map((i) =>",
    "+          i.sku === guestItem.sku ? { ...i, quantity: i.quantity + guestItem.quantity } : i",
    "+        )",
    "+      : [...items, guestItem];",
    "+  }",
    "+  return { ...state, items, updatedAt: touch(state) };",
    "+}",
    "+",
    " export function cartReducer(state: CartState = initialState, action: CartAction): CartState {",
    "   switch (action.type) {",
    "-    case \"ADD_ITEM\": {",
    "-      const existing = state.items.find((i) => i.sku === action.item.sku);",
    "-      const items = existing",
    "-        ? state.items.map((i) =>",
    "-            i.sku === action.item.sku",
    "-              ? { ...i, quantity: i.quantity + action.item.quantity }",
    "-              : i",
    "-          )",
    "-        : [...state.items, action.item];",
    "-      return { ...state, items, updatedAt: Date.now() };",
    "-    }",
    "-    case \"REMOVE_ITEM\": {",
    "-      const items = state.items.filter((i) => i.sku !== action.sku);",
    "-      return { ...state, items, updatedAt: Date.now() };",
    "-    }",
    "-    case \"UPDATE_QUANTITY\": {",
    "-      const items = state.items.map((i) =>",
    "-        i.sku === action.sku ? { ...i, quantity: action.quantity } : i",
    "-      );",
    "-      return { ...state, items, updatedAt: Date.now() };",
    "-    }",
    "-    case \"APPLY_COUPON\": {",
    "-      return { ...state, couponCode: action.code, updatedAt: Date.now() };",
    "-    }",
    "-    case \"CLEAR_CART\": {",
    "-      return { ...state, items: [], couponCode: null, updatedAt: Date.now() };",
    "-    }",
    "+    case \"ADD_ITEM\":",
    "+      return addItem(state, action.item);",
    "+    case \"REMOVE_ITEM\":",
    "+      return removeItem(state, action.sku);",
    "+    case \"UPDATE_QUANTITY\":",
    "+      return updateQuantity(state, action.sku, action.quantity);",
    "+    case \"APPLY_COUPON\":",
    "+      return applyCoupon(state, action.code);",
    "+    case \"SET_GIFT_MESSAGE\":",
    "+      return setGiftMessage(state, action.sku, action.message);",
    "+    case \"MERGE_GUEST_CART\":",
    "+      return mergeGuestCart(state, action.guestItems);",
    "+    case \"CLEAR_CART\":",
    "+      return clearCart(state);",
    "     default:",
    "       return state;",
    "   }",
    " }",
    "--- a/src/store/cart/selectors.ts",
    "+++ b/src/store/cart/selectors.ts",
    "@@ -0,0 +1,15 @@",
    "+import { CartState } from \"./types\";",
    "+",
    "+let lastItems: CartState[\"items\"] | null = null;",
    "+let lastTotal = 0;",
    "+",
    "+// Memoized on array identity: recomputes only when `items` is a new",
    "+// reference, since this runs on every render of the cart summary.",
    "+export function selectCartTotal(state: CartState): number {",
    "+  if (state.items === lastItems) {",
    "+    return lastTotal;",
    "+  }",
    "+  lastItems = state.items;",
    "+  lastTotal = state.items.reduce((sum, i) => sum + i.unitPrice * i.quantity, 0);",
    "+  return lastTotal;",
    "+}",
    "--- a/src/store/cart/index.ts",
    "+++ b/src/store/cart/index.ts",
    "@@ -1 +1,3 @@",
    " export { cartReducer } from \"./reducer\";",
    "+export { selectCartTotal } from \"./selectors\";",
    "+export type { CartState, CartAction, CartItem } from \"./types\";",
    "--- a/src/store/cart/reducer.test.ts",
    "+++ b/src/store/cart/reducer.test.ts",
    "@@ -0,0 +1,48 @@",
    "+import { cartReducer } from \"./reducer\";",
    "+import { CartState } from \"./types\";",
    "+",
    "+const baseState: CartState = {",
    "+  items: [{ sku: \"SKU-1\", name: \"Mug\", unitPrice: 10, quantity: 1 }],",
    "+  couponCode: null,",
    "+  updatedAt: 0,",
    "+};",
    "+",
    "+test(\"ADD_ITEM appends a new sku\", () => {",
    "+  const next = cartReducer(baseState, {",
    "+    type: \"ADD_ITEM\",",
    "+    item: { sku: \"SKU-2\", name: \"Plate\", unitPrice: 5, quantity: 2 },",
    "+  });",
    "+  expect(next.items).toHaveLength(2);",
    "+});",
    "+",
    "+test(\"UPDATE_QUANTITY changes the quantity for the given sku\", () => {",
    "+  const next = cartReducer(baseState, {",
    "+    type: \"UPDATE_QUANTITY\",",
    "+    sku: \"SKU-1\",",
    "+    quantity: 4,",
    "+  });",
    "+  expect(next.items[0].quantity).toBe(4);",
    "+});",
    "+",
    "+test(\"SET_GIFT_MESSAGE attaches a message to the given sku\", () => {",
    "+  const next = cartReducer(baseState, {",
    "+    type: \"SET_GIFT_MESSAGE\",",
    "+    sku: \"SKU-1\",",
    "+    message: \"Happy birthday!\",",
    "+  });",
    "+  expect(next.items[0].giftMessage).toBe(\"Happy birthday!\");",
    "+});",
    "+",
    "+test(\"MERGE_GUEST_CART sums quantities for a shared sku\", () => {",
    "+  const next = cartReducer(baseState, {",
    "+    type: \"MERGE_GUEST_CART\",",
    "+    guestItems: [{ sku: \"SKU-1\", name: \"Mug\", unitPrice: 10, quantity: 2 }],",
    "+  });",
    "+  expect(next.items[0].quantity).toBe(3);",
    "+});",
    "+",
    "+test(\"CLEAR_CART empties items and resets the coupon\", () => {",
    "+  const next = cartReducer(baseState, { type: \"CLEAR_CART\" });",
    "+  expect(next.items).toEqual([]);",
    "+  expect(next.couponCode).toBeNull();",
    "+});"
  ],
  "ground_truth": {
    "defect": true,
    "category": "logic-error",
    "accepted_categories": [
      "data-corruption"
    ],
    "severity": [
      "medium",
      "high"
    ],
    "explanation": "updateQuantity() looks up the CartItem object with .find() and mutates `item.quantity = quantity` directly, then returns `items: state.items` (the same array reference, not a copy). Every other handler in this file (addItem, removeItem, setGiftMessage, clearCart) builds a new array or new item objects, as Redux-style reducers must. Because the array reference never changes, selectCartTotal's identity-based memoization (`state.items === lastItems`) stays true after a quantity change, so it keeps returning the pre-update total, and anything holding an earlier state snapshot (undo history, a memoized selector elsewhere) silently sees the mutated value too. The new reducer.test.ts suite asserts on the returned *values* (next.items[0].quantity) for every action, including UPDATE_QUANTITY, which still pass under the bug -- none of the tests assert on array or object identity, so nothing catches the mutation."
  },
  "difficulty": "subtle",
