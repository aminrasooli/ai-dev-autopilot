{
  "id": "12-destructive-migration",
  "title": "Migration drops a table it renames",
  "diff": [
    "--- a/migrations/0042_rename_events.sql",
    "+++ b/migrations/0042_rename_events.sql",
    "@@ -1,3 +1,4 @@",
    "-ALTER TABLE events RENAME TO events_v2;",
    "+CREATE TABLE events_v2 (LIKE events INCLUDING ALL);",
    "+DROP TABLE events;",
    " CREATE INDEX idx_events_v2_ts ON events_v2 (ts);"
  ],
  "ground_truth": {
    "defect": true,
    "category": "destructive-operation",
    "severity": [
      "high",
      "critical"
    ],
    "explanation": "CREATE ... LIKE copies structure, not rows; DROP TABLE events then discards all production data the rename would have kept."
  }
}
