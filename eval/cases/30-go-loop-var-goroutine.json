    "internal/mailer/batch.go"
  ],
  "diff": [
    "--- a/go.mod",
    "+++ b/go.mod",
    "@@ -1,3 +1,3 @@",
    " module example.com/mailer",
    " ",
    " go 1.21",
    "--- a/internal/mailer/batch.go",
    "+++ b/internal/mailer/batch.go",
    "@@ -9,11 +9,10 @@ func (m *Mailer) SendBatch(msgs []Message) {",
    " \tvar wg sync.WaitGroup",
    " \tfor _, msg := range msgs {",
    " \t\twg.Add(1)",
    "-\t\tmsg := msg",
    " \t\tgo func() {",
    " \t\t\tdefer wg.Done()",
    " \t\t\tm.send(msg)",
    " \t\t}()",
    " \t}",
    " \twg.Wait()",
    " }"
  ],
  "ground_truth": {
    "defect": true,
    "category": "concurrency",
    "severity": [
      "medium",
      "high"
    ],
    "explanation": "The module targets go 1.21, where a range variable is shared across iterations: removing the per-iteration copy makes every goroutine read the same msg, so some messages send repeatedly and others never send. (Go 1.22 changed this; the go directive in the diff is what makes the defect determinate.)"
